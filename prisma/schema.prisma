// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ContactMethod {
  whatsapp
  phone
  other

  @@map("contact_method_enum")
}

enum CallRecordStatus {
  pending
  registered
  cancelled

  @@map("call_record_status_enum")
}

enum CallStatus {
  ATENDIDO
  NAO_ATENDIDO @map("NÃO ATENDIDO")
  REALIZADO

  @@map("call_status_enum")
}

enum StockUnit {
  UNIT
  BOX

  @@map("stock_unit_enum")
}

enum CouncilType {
  CRM
  CRO
  CRP
  COREN
  OTHER

  @@map("council_type_enum")
}

model Specialty {
  id                           Int                           @id @default(autoincrement())
  name                         String                        @db.VarChar(100)
  appointments                 Appointment[]
  healthProfessionalSpecialties HealthProfessionalSpecialty[]
  insuranceGuides              InsuranceGuide[]

  @@map("specialties")
}

model HealthProfessional {
  id            Int         @id @default(autoincrement())
  name          String      @db.VarChar(150)
  councilType   CouncilType @map("council_type")
  councilNumber String      @map("council_number") @db.VarChar(30)
  cpf           String      @unique @db.VarChar(11)
  phone         String?     @db.VarChar(20)
  email         String?     @db.VarChar(150)
  isActive      Boolean     @default(true) @map("is_active")
  registeredAt  DateTime    @default(now()) @map("registered_at") @db.Date
  specialties   HealthProfessionalSpecialty[]
  stockExits    StockExit[]
  insuranceGuides InsuranceGuide[]

  @@map("health_professionals")
}

model HealthProfessionalSpecialty {
  id                   Int                @id @default(autoincrement())
  healthProfessionalId Int                @map("health_professional_id")
  specialtyId          Int                @map("specialty_id")
  privatePrice         Decimal            @map("private_price") @db.Decimal(10, 2)
  healthProfessional   HealthProfessional @relation(fields: [healthProfessionalId], references: [id], onDelete: Cascade)
  specialty            Specialty          @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@unique([healthProfessionalId, specialtyId])
  @@index([specialtyId])
  @@map("health_professional_specialties")
}

model HealthPlan {
  id                      Int             @id @default(autoincrement())
  name                    String          @db.VarChar(150)
  submissionDeadlineDays  Int             @map("submission_deadline_days")
  insuranceCards          InsuranceCard[]
  insuranceGuides         InsuranceGuide[]

  @@map("health_plans")
}

model Patient {
  id             Int             @id @default(autoincrement())
  name           String          @db.VarChar(150)
  phone          String          @db.VarChar(20)
  email          String?         @db.VarChar(150)
  birthDate      DateTime        @map("birth_date") @db.Date
  cpf            String          @unique @db.VarChar(11)
  insuranceCards InsuranceCard[]
  insuranceGuides InsuranceGuide[]

  @@map("patients")
}

model InsuranceCard {
  id            Int        @id @default(autoincrement())
  patientId     Int        @map("patient_id")
  healthPlanId  Int        @map("health_plan_id")
  cardNumber    String     @map("card_number") @db.VarChar(50)
  expirationDate DateTime  @map("expiration_date") @db.Date
  patient       Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  healthPlan    HealthPlan @relation(fields: [healthPlanId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([healthPlanId])
  @@index([expirationDate])
  @@map("insurance_cards")
}

model InsuranceGuide {
  id                   Int                @id @default(autoincrement())
  healthPlanId         Int                @map("health_plan_id")
  patientId            Int                @map("patient_id")
  specialtyId          Int                @map("specialty_id")
  healthProfessionalId Int                @map("health_professional_id")
  quantity             Int
  expirationDate       DateTime           @map("expiration_date") @db.Date
  healthPlan           HealthPlan         @relation(fields: [healthPlanId], references: [id], onDelete: Restrict)
  patient              Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  specialty            Specialty          @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  healthProfessional   HealthProfessional @relation(fields: [healthProfessionalId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([healthPlanId])
  @@index([specialtyId])
  @@index([healthProfessionalId])
  @@index([expirationDate])
  @@map("insurance_guides")
}

model User {
  id                       Int           @id @default(autoincrement())
  name                     String        @db.VarChar(150)
  passwordHash             String        @map("password_hash") @db.VarChar(255)
  usernameLogin            String        @unique @map("username_login") @db.VarChar(100)
  email                    String?       @unique @map("email") @db.VarChar(150)
  isAdmin                  Boolean       @default(false) @map("is_admin")
  extension                Int?          @unique @map("extension")
  attendedAppointments     Appointment[] @relation("AttendantAppointments")
  calls                    Call[]
  messages                 Message[]
  stockBatches             StockBatch[]
  stockExits               StockExit[]

  @@map("users")
}

model Call {
  id            Int              @id @default(autoincrement())
  receivedAt    DateTime         @default(now()) @map("received_at") @db.Timestamp(3)
  origin        String           @map("origin") @db.VarChar(255)
  destination   String           @map("destination") @db.VarChar(255)
  extension     Int              @map("extension")
  status        CallStatus       @map("status")
  recordStatus  CallRecordStatus @default(pending) @map("record_status")
  note          String?          @map("note") @db.Text
  userId        Int?             @map("user_id")

  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointment Appointment?

  @@index([receivedAt])
  @@index([recordStatus])
  @@index([userId])
  @@index([status])
  @@index([receivedAt, recordStatus])
  @@index([userId, receivedAt])
  @@map("calls")
}

model Message {
  id            Int              @id @default(autoincrement())
  finishAt      DateTime         @map("finish_at") @db.Timestamp(3)
  recipient     String           @db.VarChar(30)
  name          String           @db.VarChar(150)
  userId        Int?             @map("user_id")
  note          String?          @db.Text
  recordStatus  CallRecordStatus @default(pending) @map("record_status")
  interactionId String           @map("interaction_id") @db.VarChar(64)
  content       Json?

  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointment Appointment?

  @@index([finishAt])
  @@index([recordStatus])
  @@index([userId])
  @@index([finishAt, recordStatus])
  @@index([userId, finishAt])
  @@map("messages")
}

model Appointment {
  id             Int           @id @default(autoincrement())
  date           DateTime      @db.Timestamp(3)
  clientName     String        @map("client_name") @db.VarChar(150)
  phone          String?       @db.VarChar(20)
  contactMethod  ContactMethod @map("contact_method")
  firstTime      Boolean       @map("first_time")
  scheduled      Boolean
  reason         String?       @db.VarChar(255)
  specialtyId    Int?          @map("specialty_id")
  notes          String?
  attendantId    Int?          @map("attendant_id")
  callId         Int?          @unique @map("call_id")
  messageId      Int?          @unique @map("message_id")

  specialty Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  attendant User?      @relation("AttendantAppointments", fields: [attendantId], references: [id], onDelete: SetNull)
  call      Call?      @relation(fields: [callId], references: [id], onDelete: SetNull)
  message   Message?   @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([attendantId, date])
  @@index([specialtyId, date])
  @@index([contactMethod, date])
  @@index([scheduled, date])
  @@index([firstTime, date])
  @@map("appointments")
}

model Category {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(255)
  registeredAt DateTime  @default(now()) @map("registered_at") @db.Date
  products     Product[]

  @@map("categories")
}

model Product {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(255)
  sku             String    @unique @db.VarChar(100)
  isActive        Boolean   @default(true) @map("is_active")
  categoryId      Int       @map("category_id")
  registeredAt    DateTime  @default(now()) @map("registered_at") @db.Date
  minimumStock    Int       @default(0) @map("minimum_stock")
  baseUnit        StockUnit @default(UNIT) @map("base_unit")
  unitsPerPackage Int       @default(1) @map("units_per_package")
  category        Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  stockBatches    StockBatch[]

  @@map("products")
}

model Sector {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(255)
  isActive     Boolean      @default(true) @map("is_active")
  registeredAt DateTime     @default(now()) @map("registered_at") @db.Date
  stockBatches StockBatch[]

  @@map("sectors")
}

model StorageLocation {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(255)
  stockBatches StockBatch[]

  @@map("storage_locations")
}

model Supplier {
  id           Int          @id @default(autoincrement())
  legalName    String       @map("legal_name") @db.VarChar(255)
  tradeName    String       @map("trade_name") @db.VarChar(255)
  cnpj         String       @unique @db.VarChar(18)
  phone        String       @db.VarChar(20)
  email        String       @db.VarChar(255)
  website      String?      @db.VarChar(255)
  stockBatches StockBatch[]

  @@map("suppliers")
}

model StockBatch {
  id               Int             @id @default(autoincrement())
  productId        Int             @map("product_id")
  sectorId         Int             @map("sector_id")
  supplierId       Int             @map("supplier_id")
  initialQuantity  Int             @map("initial_quantity")
  currentQuantity  Int             @map("current_quantity")
  unitCost         Decimal?        @map("unit_cost") @db.Decimal(10, 4)
  movementDate     DateTime        @map("movement_date") @db.Date
  expirationDate   DateTime?       @map("expiration_date") @db.Date
  notes            String?         @db.Text
  userId           Int             @map("user_id")
  invoiceAccessKey String?         @map("invoice_access_key") @db.VarChar(45)
  locationId       Int             @map("location_id")
  isClosed         Boolean         @default(false) @map("is_closed")
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  sector           Sector          @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  supplier         Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  user             User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  location         StorageLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  stockExits       StockExit[]

  @@map("stock_batches")
}

model StockExit {
  id                   Int                 @id @default(autoincrement())
  batchId              Int                 @map("batch_id")
  quantity             Int
  userId               Int                 @map("user_id")
  exitDate             DateTime            @map("exit_date") @db.Date
  healthProfessionalId Int?                @map("health_professional_id")
  batch                StockBatch          @relation(fields: [batchId], references: [id], onDelete: Restrict)
  user                 User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  healthProfessional   HealthProfessional? @relation(fields: [healthProfessionalId], references: [id], onDelete: SetNull)

  @@map("stock_exits")
}
