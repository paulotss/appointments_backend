// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  PROFESSIONAL
  RECEPTIONIST
  ADMIN

  @@map("user_role")
}

enum PatientFileKind {
  MEDICAL_ORDER
  PRESCRIPTION
  OTHER

  @@map("patient_file_kind")
}

enum PatientFileOrigin {
  UPLOAD
  GENERATED

  @@map("patient_file_origin")
}

enum ServiceTokenScope {
  CALLS_WRITE
  AGENT_DATA_READ
  AGENT_DATA_WRITE

  @@map("service_token_scope")
}

enum ContactMethod {
  whatsapp
  phone
  other

  @@map("contact_method_enum")
}

enum CallRecordStatus {
  pending
  registered
  cancelled

  @@map("call_record_status_enum")
}

enum CallStatus {
  ATENDIDO
  NAO_ATENDIDO @map("NÃO ATENDIDO")
  REALIZADO

  @@map("call_status_enum")
}

enum StockUnit {
  UNIT
  BOX

  @@map("stock_unit_enum")
}

enum CouncilType {
  CRM
  CRO
  CRP
  COREN
  OTHER

  @@map("council_type_enum")
}

enum InsuranceGuideStatus {
  pending        @map("pendente")
  under_analysis @map("em_analise")
  authorized     @map("autorizada")

  @@map("insurance_guide_status_enum")
}

enum ClinicalAppointmentStatus {
  marked    @map("marcado")
  confirmed @map("confirmado")
  waiting   @map("em_espera")
  attended  @map("atendido")
  finished  @map("finalizado")
  absent    @map("falta")

  @@map("clinical_appointment_status_enum")
}

enum ClinicalAppointmentType {
  private     @map("particular")
  health_plan @map("plano_de_saude")
  mixed       @map("misto")

  @@map("clinical_appointment_type_enum")
}

enum ClinicalAppointmentProcedureOrigin {
  private     @map("particular")
  package     @map("pacote")
  health_plan @map("plano_de_saude")
  benefit     @map("cartao")

  @@map("clinical_appointment_procedure_origin_enum")
}

enum ScheduleExceptionKind {
  block
  release

  @@map("schedule_exception_kind_enum")
}

enum BenefitKind {
  quota    @map("cota")
  discount @map("desconto")

  @@map("benefit_kind_enum")
}

enum BenefitSubscriptionStatus {
  active    @map("ativo")
  cancelled @map("cancelado")

  @@map("benefit_subscription_status_enum")
}

enum PatientPackageStatus {
  active     @map("ativo")
  exhausted  @map("esgotado")
  cancelled  @map("cancelado")

  @@map("patient_package_status_enum")
}

enum PaymentMethod {
  pix
  debit    @map("debito")
  credit   @map("credito")
  cash     @map("dinheiro")
  transfer @map("transferencia")

  @@map("payment_method_enum")
}

enum FinancialEntryType {
  private_procedure    @map("procedimento_particular")
  health_plan          @map("plano_de_saude")
  procedure_package    @map("pacote_procedimento")
  benefit_subscription @map("assinatura_cartao")

  @@map("financial_entry_type_enum")
}

enum FinancialEntryStatus {
  pending        @map("pendente")
  paid           @map("pago")
  partially_paid @map("parcialmente_pago")
  cancelled      @map("cancelado")

  @@map("financial_entry_status_enum")
}

enum PayableKind {
  material
  service @map("servico")

  @@map("payable_kind_enum")
}

enum PayableStatus {
  pending   @map("pendente")
  paid      @map("pago")
  cancelled @map("cancelado")

  @@map("payable_status_enum")
}

enum BillingBatchStatus {
  open      @map("aberto")
  billed    @map("faturado")
  settled   @map("baixado")
  cancelled @map("cancelado")

  @@map("billing_batch_status_enum")
}

enum TissGuideType {
  consulta
  sp_sadt

  @@map("tiss_guide_type_enum")
}

model ClinicProfile {
  id        Int     @id
  legalName String? @map("legal_name") @db.VarChar(255)
  cnpj      String? @db.VarChar(14)
  cnes      String? @db.VarChar(7)

  @@map("clinic_profiles")
}

model Specialty {
  id                            Int                           @id @default(autoincrement())
  name                          String                        @db.VarChar(100)
  appointments                  Appointment[]
  healthProfessionalSpecialties HealthProfessionalSpecialty[]
  procedures                    Procedure[]

  @@map("specialties")
}

model HealthProfessional {
  id            Int         @id @default(autoincrement())
  name          String      @db.VarChar(150)
  councilType   CouncilType @map("council_type")
  councilNumber String      @map("council_number") @db.VarChar(30)
  councilUf     String?     @map("council_uf") @db.VarChar(2)
  cbosCode      String?     @map("cbos_code") @db.VarChar(6)
  cpf           String      @unique @db.VarChar(11)
  phone         String?     @db.VarChar(20)
  email         String?     @db.VarChar(150)
  isActive      Boolean     @default(true) @map("is_active")
  registeredAt  DateTime    @default(now()) @map("registered_at") @db.Date
  specialties           HealthProfessionalSpecialty[]
  weeklyBlocks          ProfessionalWeeklyBlock[]
  dayExceptions         ProfessionalDayException[]
  scheduleRules         ProfessionalScheduleRule[]
  stockExits            StockExit[]
  insuranceGuides       InsuranceGuide[]
  clinicalAppointments  ClinicalAppointment[]
  clinicalEvolutions    ClinicalEvolution[]
  userAccount           User?

  @@map("health_professionals")
}

model ProfessionalWeeklyBlock {
  id                   Int                @id @default(autoincrement())
  healthProfessionalId Int                @map("health_professional_id")
  weekday              Int
  startMinute          Int                @map("start_minute")
  endMinute            Int                @map("end_minute")
  healthProfessional   HealthProfessional @relation(fields: [healthProfessionalId], references: [id], onDelete: Cascade)

  @@index([healthProfessionalId, weekday])
  @@map("professional_weekly_blocks")
}

model ProfessionalDayException {
  id                   Int                   @id @default(autoincrement())
  healthProfessionalId Int                   @map("health_professional_id")
  date                 DateTime              @db.Date
  kind                 ScheduleExceptionKind
  startMinute          Int                   @map("start_minute")
  endMinute            Int                   @map("end_minute")
  note                 String?               @db.VarChar(200)
  healthProfessional   HealthProfessional    @relation(fields: [healthProfessionalId], references: [id], onDelete: Cascade)

  @@index([healthProfessionalId, date])
  @@map("professional_day_exceptions")
}

model ProfessionalScheduleRule {
  id                        Int                              @id @default(autoincrement())
  healthProfessionalId      Int                              @map("health_professional_id")
  procedureId               Int                              @map("procedure_id")
  maxConcurrentAppointments Int                              @map("max_concurrent_appointments")
  durationMinutes           Int                              @map("duration_minutes")
  slotIntervalMinutes       Int                              @map("slot_interval_minutes")
  allowOverbooking          Boolean                          @default(false) @map("allow_overbooking")
  notes                     String?                          @db.VarChar(500)
  healthProfessional        HealthProfessional               @relation(fields: [healthProfessionalId], references: [id], onDelete: Cascade)
  procedure                 Procedure                        @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  windows                   ProfessionalScheduleRuleWindow[]

  @@unique([healthProfessionalId, procedureId])
  @@index([procedureId])
  @@map("professional_schedule_rules")
}

model ProfessionalScheduleRuleWindow {
  id          Int                      @id @default(autoincrement())
  ruleId      Int                      @map("rule_id")
  weekday     Int
  startMinute Int                      @map("start_minute")
  endMinute   Int                      @map("end_minute")
  rule        ProfessionalScheduleRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, weekday])
  @@map("professional_schedule_rule_windows")
}

model HealthProfessionalSpecialty {
  id                   Int                @id @default(autoincrement())
  healthProfessionalId Int                @map("health_professional_id")
  specialtyId          Int                @map("specialty_id")
  healthProfessional   HealthProfessional @relation(fields: [healthProfessionalId], references: [id], onDelete: Cascade)
  specialty            Specialty          @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@unique([healthProfessionalId, specialtyId])
  @@index([specialtyId])
  @@map("health_professional_specialties")
}

model HealthPlan {
  id                     Int                   @id @default(autoincrement())
  name                   String                @db.VarChar(150)
  submissionDeadlineDays Int                   @map("submission_deadline_days")
  registroAns            String?               @map("registro_ans") @db.VarChar(6)
  providerCode           String?               @map("provider_code") @db.VarChar(20)
  tissVersion            String                @default("4.03.00") @map("tiss_version") @db.VarChar(10)
  insuranceCards         InsuranceCard[]
  insuranceGuides        InsuranceGuide[]
  procedurePrices        HealthPlanProcedure[]
  billingBatches         BillingBatch[]

  @@map("health_plans")
}

model Patient {
  id                   Int                   @id @default(autoincrement())
  name                 String                @db.VarChar(150)
  phone                String                @db.VarChar(20)
  email                String?               @db.VarChar(150)
  birthDate            DateTime?             @map("birth_date") @db.Date
  cpf                  String?               @unique @db.VarChar(11)
  insuranceCards       InsuranceCard[]
  insuranceGuides      InsuranceGuide[]
  clinicalAppointments ClinicalAppointment[]
  packages             PatientPackage[]
  benefitSubscriptions BenefitSubscription[]         @relation("BenefitHolder")
  benefitDependents    BenefitSubscriptionDependent[]
  userAccount          User?
  files                PatientFile[]
  clinicalChart        PatientClinicalChart?
  clinicalEvolutions   ClinicalEvolution[]

  @@map("patients")
}

model InsuranceCard {
  id            Int        @id @default(autoincrement())
  patientId     Int        @map("patient_id")
  healthPlanId  Int        @map("health_plan_id")
  cardNumber    String     @map("card_number") @db.VarChar(50)
  expirationDate DateTime? @map("expiration_date") @db.Date
  patient       Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  healthPlan    HealthPlan @relation(fields: [healthPlanId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([healthPlanId])
  @@index([expirationDate])
  @@map("insurance_cards")
}

model Procedure {
  id               Int                           @id @default(autoincrement())
  specialtyId      Int                           @map("specialty_id")
  name             String                        @db.VarChar(150)
  value            Decimal                       @db.Decimal(10, 2)
  tissGuideType    TissGuideType                 @default(sp_sadt) @map("tiss_guide_type")
  specialty        Specialty                     @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  healthPlanPrices      HealthPlanProcedure[]
  guideProcedures       InsuranceGuideProcedure[]
  appointmentProcedures ClinicalAppointmentProcedure[]
  financialEntryItems   FinancialEntryItem[]
  packageItems                 ProcedurePackageItem[]
  patientPackageItems          PatientPackageItem[]
  scheduleRules                ProfessionalScheduleRule[]
  benefitProcedures            BenefitProcedure[]
  benefitEntitlementProcedures BenefitEntitlementProcedure[]

  @@index([specialtyId])
  @@map("procedures")
}

model HealthPlanProcedure {
  id           Int        @id @default(autoincrement())
  healthPlanId Int        @map("health_plan_id")
  procedureId  Int        @map("procedure_id")
  tissCode     String     @map("tiss_code") @db.VarChar(20)
  value        Decimal    @db.Decimal(10, 2)
  healthPlan   HealthPlan @relation(fields: [healthPlanId], references: [id], onDelete: Restrict)
  procedure    Procedure  @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@unique([healthPlanId, procedureId])
  @@unique([healthPlanId, tissCode])
  @@index([procedureId])
  @@map("health_plan_procedures")
}

model InsuranceGuide {
  id                   Int                        @id @default(autoincrement())
  healthPlanId         Int                        @map("health_plan_id")
  patientId            Int                        @map("patient_id")
  healthProfessionalId Int                        @map("health_professional_id")
  guideNumber            String?                    @unique @map("guide_number") @db.VarChar(50)
  authorizationPassword  String?                    @map("authorization_password") @db.VarChar(20)
  authorizationDate      DateTime                   @map("authorization_date") @db.Date
  expirationDate         DateTime                   @map("expiration_date") @db.Date
  isBilled             Boolean                    @default(false) @map("is_billed")
  status               InsuranceGuideStatus       @default(pending)
  tissGuideType        TissGuideType?             @map("tiss_guide_type")
  healthPlan           HealthPlan                 @relation(fields: [healthPlanId], references: [id], onDelete: Restrict)
  patient              Patient                    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  healthProfessional   HealthProfessional         @relation(fields: [healthProfessionalId], references: [id], onDelete: Restrict)
  procedures                 InsuranceGuideProcedure[]
  documents                  InsuranceGuideDocument[]
  clinicalAppointmentGuides  ClinicalAppointmentGuide[]
  appointmentProcedures      ClinicalAppointmentProcedure[]
  billingBatchGuide          BillingBatchGuide?

  @@index([patientId])
  @@index([healthPlanId])
  @@index([healthProfessionalId])
  @@index([expirationDate])
  @@index([status])
  @@index([tissGuideType])
  @@map("insurance_guides")
}

model InsuranceGuideDocument {
  id               Int            @id @default(autoincrement())
  insuranceGuideId Int            @map("insurance_guide_id")
  originalName     String         @map("original_name") @db.VarChar(255)
  storageKey       String         @map("storage_key") @db.VarChar(500)
  mimeType         String         @map("mime_type") @db.VarChar(100)
  sizeBytes        Int            @map("size_bytes")
  uploadedAt       DateTime       @default(now()) @map("uploaded_at") @db.Timestamp(3)
  insuranceGuide   InsuranceGuide @relation(fields: [insuranceGuideId], references: [id], onDelete: Cascade)

  @@index([insuranceGuideId])
  @@map("insurance_guide_documents")
}

model InsuranceGuideProcedure {
  id                  Int            @id @default(autoincrement())
  insuranceGuideId    Int            @map("insurance_guide_id")
  procedureId         Int            @map("procedure_id")
  authorizedQuantity  Int            @map("authorized_quantity")
  usedQuantity        Int            @default(0) @map("used_quantity")
  value               Decimal        @db.Decimal(10, 2)
  insuranceGuide      InsuranceGuide @relation(fields: [insuranceGuideId], references: [id], onDelete: Cascade)
  procedure           Procedure      @relation(fields: [procedureId], references: [id], onDelete: Restrict)

  @@unique([insuranceGuideId, procedureId])
  @@index([procedureId])
  @@map("insurance_guide_procedures")
}

model ClinicalAppointment {
  id                   Int                            @id @default(autoincrement())
  patientId            Int                            @map("patient_id")
  healthProfessionalId Int                            @map("health_professional_id")
  scheduledAt          DateTime                       @map("scheduled_at") @db.Timestamp(3)
  endsAt               DateTime                       @map("ends_at") @db.Timestamp(3)
  status               ClinicalAppointmentStatus      @default(marked)
  type                 ClinicalAppointmentType
  notes                String?                        @db.Text
  patient              Patient                        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  healthProfessional   HealthProfessional             @relation(fields: [healthProfessionalId], references: [id], onDelete: Restrict)
  insuranceGuides      ClinicalAppointmentGuide[]
  procedures           ClinicalAppointmentProcedure[]
  financialEntry       FinancialEntry?
  clinicalEvolutions   ClinicalEvolution[]

  @@index([patientId])
  @@index([healthProfessionalId])
  @@index([scheduledAt])
  @@index([endsAt])
  @@index([status])
  @@index([type])
  @@map("clinical_appointments")
}

model PatientFile {
  id              Int               @id @default(autoincrement())
  patientId       Int               @map("patient_id")
  kind            PatientFileKind
  origin          PatientFileOrigin
  title           String?           @db.VarChar(200)
  originalName    String?           @map("original_name") @db.VarChar(255)
  storageKey      String?           @map("storage_key") @db.VarChar(500)
  mimeType        String?           @map("mime_type") @db.VarChar(100)
  sizeBytes       Int?              @map("size_bytes")
  content         Json?
  createdByUserId Int               @map("created_by_user_id")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamp(3)
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy       User              @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([createdByUserId])
  @@map("patient_files")
}

model PatientClinicalChart {
  id                 Int      @id @default(autoincrement())
  patientId          Int      @unique @map("patient_id")
  allergies          String?  @db.Text
  chronicConditions  String?  @map("chronic_conditions") @db.Text
  currentMedications String?  @map("current_medications") @db.Text
  personalHistory    String?  @map("personal_history") @db.Text
  familyHistory      String?  @map("family_history") @db.Text
  habits             String?  @db.Text
  updatedByUserId    Int?     @map("updated_by_user_id")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamp(3)
  patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  updatedBy          User?    @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("patient_clinical_charts")
}

model ClinicalEvolution {
  id                    Int                 @id @default(autoincrement())
  patientId             Int                 @map("patient_id")
  healthProfessionalId  Int                 @map("health_professional_id")
  clinicalAppointmentId Int?                @map("clinical_appointment_id")
  occurredAt            DateTime            @map("occurred_at") @db.Timestamp(3)
  subjective            String              @db.Text
  objective             String              @db.Text
  assessment            String              @db.Text
  plan                  String              @db.Text
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamp(3)
  patient               Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  healthProfessional    HealthProfessional  @relation(fields: [healthProfessionalId], references: [id], onDelete: Restrict)
  clinicalAppointment   ClinicalAppointment? @relation(fields: [clinicalAppointmentId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([healthProfessionalId])
  @@index([clinicalAppointmentId])
  @@map("clinical_evolutions")
}

model ClinicalAppointmentGuide {
  id                    Int                  @id @default(autoincrement())
  clinicalAppointmentId Int                  @map("clinical_appointment_id")
  insuranceGuideId      Int                  @map("insurance_guide_id")
  clinicalAppointment   ClinicalAppointment  @relation(fields: [clinicalAppointmentId], references: [id], onDelete: Cascade)
  insuranceGuide        InsuranceGuide       @relation(fields: [insuranceGuideId], references: [id], onDelete: Restrict)

  @@unique([clinicalAppointmentId, insuranceGuideId])
  @@index([insuranceGuideId])
  @@map("clinical_appointment_guides")
}

model ClinicalAppointmentProcedure {
  id                    Int                                 @id @default(autoincrement())
  clinicalAppointmentId Int                                 @map("clinical_appointment_id")
  procedureId           Int                                 @map("procedure_id")
  origin                ClinicalAppointmentProcedureOrigin
  patientPackageItemId  Int?                                @map("patient_package_item_id")
  insuranceGuideId      Int?                                @map("insurance_guide_id")
  benefitEntitlementId  Int?                                @map("benefit_entitlement_id")
  clinicalAppointment   ClinicalAppointment                 @relation(fields: [clinicalAppointmentId], references: [id], onDelete: Cascade)
  procedure             Procedure                           @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  patientPackageItem    PatientPackageItem?                 @relation(fields: [patientPackageItemId], references: [id], onDelete: Restrict)
  insuranceGuide        InsuranceGuide?                     @relation(fields: [insuranceGuideId], references: [id], onDelete: Restrict)
  benefitEntitlement    BenefitEntitlement?                 @relation(fields: [benefitEntitlementId], references: [id], onDelete: Restrict)

  @@unique([clinicalAppointmentId, procedureId])
  @@index([procedureId])
  @@index([patientPackageItemId])
  @@index([insuranceGuideId])
  @@index([benefitEntitlementId])
  @@map("clinical_appointment_procedures")
}

model ProcedurePackage {
  id              Int                     @id @default(autoincrement())
  name            String                  @db.VarChar(150)
  discountPercent Decimal                 @map("discount_percent") @db.Decimal(5, 2)
  isActive        Boolean                 @default(true) @map("is_active")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamp(3)
  items           ProcedurePackageItem[]
  patientPackages PatientPackage[]

  @@map("procedure_packages")
}

model ProcedurePackageItem {
  id          Int              @id @default(autoincrement())
  packageId   Int              @map("package_id")
  procedureId Int              @map("procedure_id")
  quantity    Int
  package     ProcedurePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  procedure   Procedure        @relation(fields: [procedureId], references: [id], onDelete: Restrict)

  @@unique([packageId, procedureId])
  @@index([procedureId])
  @@map("procedure_package_items")
}

model PatientPackage {
  id             Int                  @id @default(autoincrement())
  patientId      Int                  @map("patient_id")
  packageId      Int                  @map("package_id")
  status         PatientPackageStatus @default(active)
  assignedAt     DateTime             @default(now()) @map("assigned_at") @db.Timestamp(3)
  patient        Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  package        ProcedurePackage     @relation(fields: [packageId], references: [id], onDelete: Restrict)
  items          PatientPackageItem[]
  financialEntry FinancialEntry?

  @@index([patientId])
  @@index([packageId])
  @@index([status])
  @@map("patient_packages")
}

model PatientPackageItem {
  id                 Int                            @id @default(autoincrement())
  patientPackageId   Int                            @map("patient_package_id")
  procedureId        Int                            @map("procedure_id")
  quantity           Int
  usedQuantity       Int                            @default(0) @map("used_quantity")
  unitValue          Decimal                        @map("unit_value") @db.Decimal(10, 2)
  patientPackage     PatientPackage                 @relation(fields: [patientPackageId], references: [id], onDelete: Cascade)
  procedure          Procedure                      @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  appointmentProcedures ClinicalAppointmentProcedure[]

  @@unique([patientPackageId, procedureId])
  @@index([procedureId])
  @@map("patient_package_items")
}

model User {
  id                       Int                  @id @default(autoincrement())
  name                     String               @db.VarChar(150)
  passwordHash             String               @map("password_hash") @db.VarChar(255)
  usernameLogin            String               @unique @map("username_login") @db.VarChar(100)
  email                    String?              @unique @map("email") @db.VarChar(150)
  role                     UserRole             @default(RECEPTIONIST)
  patientId                Int?                 @unique @map("patient_id")
  healthProfessionalId     Int?                 @unique @map("health_professional_id")
  extension                Int?                 @unique @map("extension")
  patient                  Patient?             @relation(fields: [patientId], references: [id], onDelete: SetNull)
  healthProfessional       HealthProfessional?  @relation(fields: [healthProfessionalId], references: [id], onDelete: SetNull)
  attendedAppointments     Appointment[]        @relation("AttendantAppointments")
  calls                    Call[]
  messages                 Message[]
  stockBatches             StockBatch[]
  stockExits               StockExit[]
  serviceAccessTokens      ServiceAccessToken[]
  patientFiles             PatientFile[]
  updatedClinicalCharts    PatientClinicalChart[]

  @@map("users")
}

model ServiceAccessToken {
  id          Int                 @id @default(autoincrement())
  name        String              @db.VarChar(150)
  tokenHash   String              @unique @map("token_hash") @db.VarChar(64)
  jti         String              @unique @db.VarChar(64)
  scopes      ServiceTokenScope[]
  expiresAt   DateTime?           @map("expires_at") @db.Timestamp(3)
  revokedAt   DateTime?           @map("revoked_at") @db.Timestamp(3)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamp(3)
  createdById Int                 @map("created_by_id")
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById])
  @@map("service_access_tokens")
}

model Call {
  id            Int              @id @default(autoincrement())
  receivedAt    DateTime         @default(now()) @map("received_at") @db.Timestamp(3)
  origin        String           @map("origin") @db.VarChar(255)
  destination   String           @map("destination") @db.VarChar(255)
  extension     Int              @map("extension")
  status        CallStatus       @map("status")
  recordStatus  CallRecordStatus @default(pending) @map("record_status")
  note          String?          @map("note") @db.Text
  userId        Int?             @map("user_id")

  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointment Appointment?

  @@index([receivedAt])
  @@index([recordStatus])
  @@index([userId])
  @@index([status])
  @@index([receivedAt, recordStatus])
  @@index([userId, receivedAt])
  @@map("calls")
}

model Message {
  id            Int              @id @default(autoincrement())
  finishAt      DateTime         @map("finish_at") @db.Timestamp(3)
  recipient     String           @db.VarChar(30)
  name          String           @db.VarChar(150)
  userId        Int?             @map("user_id")
  note          String?          @db.Text
  recordStatus  CallRecordStatus @default(pending) @map("record_status")
  interactionId String           @map("interaction_id") @db.VarChar(64)
  content       Json?

  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointment Appointment?

  @@index([finishAt])
  @@index([recordStatus])
  @@index([userId])
  @@index([finishAt, recordStatus])
  @@index([userId, finishAt])
  @@map("messages")
}

model Appointment {
  id             Int           @id @default(autoincrement())
  date           DateTime      @db.Timestamp(3)
  clientName     String        @map("client_name") @db.VarChar(150)
  phone          String?       @db.VarChar(20)
  contactMethod  ContactMethod @map("contact_method")
  firstTime      Boolean       @map("first_time")
  scheduled      Boolean
  reason         String?       @db.VarChar(255)
  specialtyId    Int?          @map("specialty_id")
  notes          String?
  attendantId    Int?          @map("attendant_id")
  callId         Int?          @unique @map("call_id")
  messageId      Int?          @unique @map("message_id")

  specialty Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  attendant User?      @relation("AttendantAppointments", fields: [attendantId], references: [id], onDelete: SetNull)
  call      Call?      @relation(fields: [callId], references: [id], onDelete: SetNull)
  message   Message?   @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([attendantId, date])
  @@index([specialtyId, date])
  @@index([contactMethod, date])
  @@index([scheduled, date])
  @@index([firstTime, date])
  @@map("appointments")
}

model Category {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(255)
  registeredAt DateTime  @default(now()) @map("registered_at") @db.Date
  products     Product[]

  @@map("categories")
}

model Product {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(255)
  sku             String    @unique @db.VarChar(100)
  isActive        Boolean   @default(true) @map("is_active")
  categoryId      Int       @map("category_id")
  registeredAt    DateTime  @default(now()) @map("registered_at") @db.Date
  minimumStock    Int       @default(0) @map("minimum_stock")
  baseUnit        StockUnit @default(UNIT) @map("base_unit")
  unitsPerPackage Int       @default(1) @map("units_per_package")
  category        Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  stockBatches    StockBatch[]

  @@map("products")
}

model Sector {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(255)
  isActive     Boolean      @default(true) @map("is_active")
  registeredAt DateTime     @default(now()) @map("registered_at") @db.Date
  stockBatches StockBatch[]

  @@map("sectors")
}

model StorageLocation {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(255)
  stockBatches StockBatch[]

  @@map("storage_locations")
}

model Supplier {
  id           Int          @id @default(autoincrement())
  legalName    String       @map("legal_name") @db.VarChar(255)
  tradeName    String       @map("trade_name") @db.VarChar(255)
  cnpj         String       @unique @db.VarChar(18)
  phone        String       @db.VarChar(20)
  email        String       @db.VarChar(255)
  website      String?      @db.VarChar(255)
  stockBatches StockBatch[]
  payables     Payable[]

  @@map("suppliers")
}

model StockBatch {
  id               Int             @id @default(autoincrement())
  productId        Int             @map("product_id")
  sectorId         Int             @map("sector_id")
  supplierId       Int             @map("supplier_id")
  initialQuantity  Int             @map("initial_quantity")
  currentQuantity  Int             @map("current_quantity")
  unitCost         Decimal?        @map("unit_cost") @db.Decimal(10, 4)
  movementDate     DateTime        @map("movement_date") @db.Date
  expirationDate   DateTime?       @map("expiration_date") @db.Date
  notes            String?         @db.Text
  userId           Int             @map("user_id")
  invoiceAccessKey String?         @map("invoice_access_key") @db.VarChar(45)
  locationId       Int             @map("location_id")
  isClosed         Boolean         @default(false) @map("is_closed")
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  sector           Sector          @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  supplier         Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  user             User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  location         StorageLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  stockExits       StockExit[]

  @@map("stock_batches")
}

model StockExit {
  id                   Int                 @id @default(autoincrement())
  batchId              Int                 @map("batch_id")
  quantity             Int
  userId               Int                 @map("user_id")
  exitDate             DateTime            @map("exit_date") @db.Date
  healthProfessionalId Int?                @map("health_professional_id")
  batch                StockBatch          @relation(fields: [batchId], references: [id], onDelete: Restrict)
  user                 User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  healthProfessional   HealthProfessional? @relation(fields: [healthProfessionalId], references: [id], onDelete: SetNull)

  @@map("stock_exits")
}

model FinancialEntry {
  id                    Int                   @id @default(autoincrement())
  type                  FinancialEntryType
  status                FinancialEntryStatus
  grossAmount           Decimal               @map("gross_amount") @db.Decimal(10, 2)
  discountAmount        Decimal               @default(0) @map("discount_amount") @db.Decimal(10, 2)
  surchargeAmount       Decimal               @default(0) @map("surcharge_amount") @db.Decimal(10, 2)
  amount                Decimal               @db.Decimal(10, 2)
  receivedAmount        Decimal               @default(0) @map("received_amount") @db.Decimal(10, 2)
  paymentMethod         PaymentMethod?        @map("payment_method")
  paidAt                DateTime?             @map("paid_at") @db.Timestamp(3)
  notes                 String?               @db.Text
  clinicalAppointmentId Int?                  @unique @map("clinical_appointment_id")
  billingBatchId        Int?                  @unique @map("billing_batch_id")
  patientPackageId      Int?                  @unique @map("patient_package_id")
  benefitSubscriptionId Int?                  @map("benefit_subscription_id")
  dueDate               DateTime?             @map("due_date") @db.Date
  installmentNumber     Int?                  @map("installment_number")
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamp(3)
  clinicalAppointment   ClinicalAppointment?  @relation(fields: [clinicalAppointmentId], references: [id], onDelete: Restrict)
  billingBatch          BillingBatch?         @relation(fields: [billingBatchId], references: [id], onDelete: Restrict)
  patientPackage        PatientPackage?       @relation(fields: [patientPackageId], references: [id], onDelete: Restrict)
  benefitSubscription   BenefitSubscription?  @relation(fields: [benefitSubscriptionId], references: [id], onDelete: Restrict)
  items                 FinancialEntryItem[]

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([paidAt])
  @@index([benefitSubscriptionId])
  @@index([dueDate])
  @@map("financial_entries")
}

model FinancialEntryItem {
  id               Int            @id @default(autoincrement())
  financialEntryId Int            @map("financial_entry_id")
  procedureId      Int            @map("procedure_id")
  quantity         Int
  unitValue        Decimal        @map("unit_value") @db.Decimal(10, 2)
  description      String         @db.VarChar(150)
  financialEntry   FinancialEntry @relation(fields: [financialEntryId], references: [id], onDelete: Cascade)
  procedure        Procedure      @relation(fields: [procedureId], references: [id], onDelete: Restrict)

  @@index([procedureId])
  @@map("financial_entry_items")
}

model Payable {
  id            Int                  @id @default(autoincrement())
  supplierId    Int                  @map("supplier_id")
  kind          PayableKind
  description   String               @db.VarChar(255)
  amount        Decimal              @db.Decimal(10, 2)
  dueDate       DateTime             @map("due_date") @db.Date
  invoiceNumber String?              @map("invoice_number") @db.VarChar(60)
  notes         String?              @db.Text
  status        PayableStatus        @default(pending)
  paidAt        DateTime?            @map("paid_at") @db.Timestamp(3)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamp(3)
  supplier      Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  documents     FinancialDocument[]
  financialExit FinancialExit?

  @@index([supplierId])
  @@index([status])
  @@index([dueDate])
  @@map("payables")
}

model FinancialExit {
  id            Int           @id @default(autoincrement())
  payableId     Int           @unique @map("payable_id")
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @map("payment_method")
  paidAt        DateTime      @map("paid_at") @db.Timestamp(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  payable       Payable       @relation(fields: [payableId], references: [id], onDelete: Restrict)

  @@index([paidAt])
  @@index([paymentMethod])
  @@map("financial_exits")
}

model FinancialDocument {
  id           Int      @id @default(autoincrement())
  payableId    Int      @map("payable_id")
  originalName String   @map("original_name") @db.VarChar(255)
  storageKey   String   @map("storage_key") @db.VarChar(500)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  sizeBytes    Int      @map("size_bytes")
  uploadedAt   DateTime @default(now()) @map("uploaded_at") @db.Timestamp(3)
  payable      Payable  @relation(fields: [payableId], references: [id], onDelete: Cascade)

  @@index([payableId])
  @@map("financial_documents")
}

model BillingBatch {
  id             Int                 @id @default(autoincrement())
  healthPlanId   Int                 @map("health_plan_id")
  batchNumber    String              @unique @map("batch_number") @db.VarChar(40)
  status         BillingBatchStatus  @default(open)
  billedAmount   Decimal             @map("billed_amount") @db.Decimal(10, 2)
  receivedAmount Decimal             @default(0) @map("received_amount") @db.Decimal(10, 2)
  billedAt       DateTime?           @map("billed_at") @db.Timestamp(3)
  settledAt      DateTime?           @map("settled_at") @db.Timestamp(3)
  protocolNumber String?             @map("protocol_number") @db.VarChar(80)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamp(3)
  healthPlan     HealthPlan          @relation(fields: [healthPlanId], references: [id], onDelete: Restrict)
  guides         BillingBatchGuide[]
  financialEntry FinancialEntry?

  @@index([healthPlanId])
  @@index([status])
  @@index([createdAt])
  @@map("billing_batches")
}

model BillingBatchGuide {
  id               Int            @id @default(autoincrement())
  billingBatchId   Int            @map("billing_batch_id")
  insuranceGuideId Int            @unique @map("insurance_guide_id")
  billedAmount     Decimal        @map("billed_amount") @db.Decimal(10, 2)
  receivedAmount   Decimal?       @map("received_amount") @db.Decimal(10, 2)
  glosaReason      String?        @map("glosa_reason") @db.Text
  billingBatch     BillingBatch   @relation(fields: [billingBatchId], references: [id], onDelete: Cascade)
  insuranceGuide   InsuranceGuide @relation(fields: [insuranceGuideId], references: [id], onDelete: Restrict)

  @@index([billingBatchId])
  @@map("billing_batch_guides")
}

model BenefitPlan {
  id            Int                   @id @default(autoincrement())
  name          String                @db.VarChar(150)
  annualPrice   Decimal               @map("annual_price") @db.Decimal(10, 2)
  adhesionFee   Decimal               @default(20) @map("adhesion_fee") @db.Decimal(10, 2)
  dependentFee  Decimal               @default(5) @map("dependent_fee") @db.Decimal(10, 2)
  isActive      Boolean               @default(true) @map("is_active")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamp(3)
  benefits      Benefit[]
  subscriptions BenefitSubscription[]

  @@map("benefit_plans")
}

model Benefit {
  id              Int                @id @default(autoincrement())
  planId          Int                @map("plan_id")
  title           String             @db.VarChar(150)
  description     String?            @db.Text
  kind            BenefitKind
  quantity        Int?
  discountPercent Decimal?           @map("discount_percent") @db.Decimal(5, 2)
  plan            BenefitPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  procedures      BenefitProcedure[]
  entitlements    BenefitEntitlement[]

  @@index([planId])
  @@map("benefits")
}

model BenefitProcedure {
  id          Int       @id @default(autoincrement())
  benefitId   Int       @map("benefit_id")
  procedureId Int       @map("procedure_id")
  benefit     Benefit   @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Restrict)

  @@unique([benefitId, procedureId])
  @@index([procedureId])
  @@map("benefit_procedures")
}

model BenefitSubscription {
  id                    Int                           @id @default(autoincrement())
  patientId             Int                           @map("patient_id")
  planId                Int                           @map("plan_id")
  startsAt              DateTime                      @map("starts_at") @db.Date
  expiresAt             DateTime                      @map("expires_at") @db.Date
  billingDay            Int                           @map("billing_day")
  installmentCount      Int                           @map("installment_count")
  status                BenefitSubscriptionStatus     @default(active)
  cardNumber            String                        @unique @map("card_number") @db.VarChar(20)
  pagbankSubscriptionId String?                       @map("pagbank_subscription_id") @db.VarChar(80)
  createdAt             DateTime                      @default(now()) @map("created_at") @db.Timestamp(3)
  patient               Patient                       @relation("BenefitHolder", fields: [patientId], references: [id], onDelete: Restrict)
  plan                  BenefitPlan                   @relation(fields: [planId], references: [id], onDelete: Restrict)
  dependents            BenefitSubscriptionDependent[]
  entitlements          BenefitEntitlement[]
  financialEntries      FinancialEntry[]

  @@index([patientId])
  @@index([planId])
  @@index([status])
  @@index([expiresAt])
  @@map("benefit_subscriptions")
}

model BenefitSubscriptionDependent {
  id             Int                 @id @default(autoincrement())
  subscriptionId Int                 @map("subscription_id")
  patientId      Int                 @map("patient_id")
  subscription   BenefitSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  patient        Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, patientId])
  @@index([patientId])
  @@map("benefit_subscription_dependents")
}

model BenefitEntitlement {
  id                    Int                            @id @default(autoincrement())
  subscriptionId        Int                            @map("subscription_id")
  benefitId             Int                            @map("benefit_id")
  kind                  BenefitKind
  title                 String                         @db.VarChar(150)
  quantity              Int?
  usedQuantity          Int                            @default(0) @map("used_quantity")
  discountPercent       Decimal?                       @map("discount_percent") @db.Decimal(5, 2)
  subscription          BenefitSubscription            @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  benefit               Benefit                        @relation(fields: [benefitId], references: [id], onDelete: Restrict)
  procedures            BenefitEntitlementProcedure[]
  notes                 BenefitNote[]
  appointmentProcedures ClinicalAppointmentProcedure[]

  @@index([subscriptionId])
  @@index([benefitId])
  @@map("benefit_entitlements")
}

model BenefitEntitlementProcedure {
  id            Int                @id @default(autoincrement())
  entitlementId Int                @map("entitlement_id")
  procedureId   Int                @map("procedure_id")
  entitlement   BenefitEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  procedure     Procedure          @relation(fields: [procedureId], references: [id], onDelete: Restrict)

  @@unique([entitlementId, procedureId])
  @@index([procedureId])
  @@map("benefit_entitlement_procedures")
}

model BenefitNote {
  id            Int                @id @default(autoincrement())
  entitlementId Int                @map("entitlement_id")
  description   String             @db.Text
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamp(3)
  entitlement   BenefitEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@index([entitlementId])
  @@map("benefit_notes")
}
